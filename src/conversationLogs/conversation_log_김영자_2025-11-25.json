    "main_diagnosis_diagnosis_b": {
      "section": "main",
      "subSection": "diagnosis_diagnosis_b",
      "messages": [
        {
          "id": "main_diagnosis_diagnosis_b_assistant_intro_1764086922012",
          "role": "assistant",
          "content": "다음으로는 다리 근력 저하에 대한 질문입니다.",
